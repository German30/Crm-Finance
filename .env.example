# Copia este fichero a .env y cambia TODOS los valores antes de usarlo fuera de tu
# maquina. docker compose lee .env automaticamente.
#
#   cp .env.example .env
#
# NO subas .env a control de versiones.

# Contrasena del usuario root del contenedor de MySQL.
MYSQL_ROOT_PASSWORD=CambiaEstaClaveRoot1

# Usuario con el que se conecta la API. Solo recibe SELECT/INSERT/UPDATE/DELETE
# sobre crm_finance: nada de DDL, que lo gestionan los scripts de database/mysql/.
CRM_APP_USER=crm_app
CRM_APP_PASSWORD=CambiaEstaClaveApp1

# Clave de firma de los JWT. Al menos 32 caracteres para HMAC-SHA256.
# Generar una nueva:  openssl rand -base64 48
JWT_SECRET_KEY=CambiaEstaClaveDeFirmaPorUnaLargaYAleatoria0123456789

JWT_ISSUER=http://localhost:5170
JWT_AUDIENCE=http://localhost:4200

# Origen del frontend Angular que puede llamar a la API.
# Puerto en el que se publica MySQL. El 3306 y el 33060 los usa el MySQL local.
MYSQL_PORT=3307

# Puerto en el que se publica la API. Cambialo si el 5170 ya esta ocupado.
API_PORT=5170

CORS_ORIGIN=http://localhost:4200
