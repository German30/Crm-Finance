# Copia este fichero a .env y cambia TODOS los valores antes de usarlo fuera de tu
# maquina. docker compose lee .env automaticamente.
#
#   cp .env.example .env
#
# NO subas .env a control de versiones.

# ---------------------------------------------------------------- frontend --

# Puerto en el que se publica la aplicacion.
WEB_PORT=4200

# Solo para docker-compose.yml (frontend suelto): a donde reenvia nginx /api.
#
#   http://host.docker.internal:5170   backend corriendo en tu maquina
#   http://api:8080                    backend en la misma red de Docker
#   https://api.tu-dominio.mx          backend en otro servidor
#
# En docker-compose.full.yml este valor se ignora: ahi siempre es http://api:8080.
API_UPSTREAM=http://host.docker.internal:5170

# ------------------------------------------- solo para docker-compose.full ---

# Ruta al repositorio del backend, relativa a este directorio.
BACKEND_PATH=../CRMFinaciertoBackend

# Development deja Swagger disponible en /swagger. Para produccion: Production.
ASPNETCORE_ENVIRONMENT=Development

# Contrasena del usuario root del contenedor de MySQL.
MYSQL_ROOT_PASSWORD=CambiaEstaClaveRoot1

# Usuario con el que se conecta la API. Solo recibe SELECT/INSERT/UPDATE/DELETE
# sobre crm_finance: nada de DDL, que lo gestionan los scripts del backend.
CRM_APP_USER=crm_app
CRM_APP_PASSWORD=CambiaEstaClaveApp1

# Clave de firma de los JWT. Al menos 32 caracteres para HMAC-SHA256.
# Generar una nueva:  openssl rand -base64 48
JWT_SECRET_KEY=CambiaEstaClaveDeFirmaPorUnaLargaYAleatoria0123456789

JWT_ISSUER=http://localhost:5170
JWT_AUDIENCE=http://localhost:4200

# Origen que la API acepta por CORS. La aplicacion no lo necesita (todo pasa por
# el proxy del frontend), pero si lo necesita quien pruebe la API desde Swagger.
CORS_ORIGIN=http://localhost:4200

# Puerto en el que se publica MySQL. El 3306 suele estar ocupado por el local.
MYSQL_PORT=3307

# Puerto en el que se publica la API.
API_PORT=5170
